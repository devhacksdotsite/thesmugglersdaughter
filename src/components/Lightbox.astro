<!-- Lightbox overlay -->
<div
	id="lightbox"
	class="fixed inset-0 z-[200] hidden cursor-zoom-out items-center justify-center bg-black/90 p-4 backdrop-blur-sm"
	role="dialog"
	aria-modal="true"
	aria-label="Image lightbox"
>
	<button
		id="lightbox-close"
		class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white transition-colors hover:bg-white/20"
		aria-label="Close lightbox"
	>
		<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
	</button>
	<img id="lightbox-img" class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain" src="" alt="" />
</div>

<script>
	const lightbox = document.getElementById('lightbox')!;
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
	const lightboxClose = document.getElementById('lightbox-close')!;
	let lastFocused: HTMLElement | null = null;

	// Make all images in article clickable
	document.querySelectorAll('article img').forEach((img) => {
		const el = img as HTMLImageElement;
		el.style.cursor = 'zoom-in';
		el.setAttribute('tabindex', '0');
		el.setAttribute('role', 'button');
		el.setAttribute('aria-label', `View full size: ${el.alt || 'image'}`);

		const openLightbox = () => {
			lastFocused = document.activeElement as HTMLElement;
			lightboxImg.src = el.src;
			lightboxImg.alt = el.alt;
			lightbox.classList.remove('hidden');
			lightbox.classList.add('flex');
			document.body.style.overflow = 'hidden';
			lightboxClose.focus();
		};

		el.addEventListener('click', openLightbox);
		el.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				openLightbox();
			}
		});
	});

	function closeLightbox() {
		lightbox.classList.add('hidden');
		lightbox.classList.remove('flex');
		document.body.style.overflow = '';
		lastFocused?.focus();
	}

	lightboxClose.addEventListener('click', closeLightbox);
	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) closeLightbox();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) closeLightbox();
	});

	// Focus trap
	lightbox.addEventListener('keydown', (e) => {
		if (e.key !== 'Tab' || lightbox.classList.contains('hidden')) return;
		e.preventDefault();
		lightboxClose.focus();
	});
</script>
